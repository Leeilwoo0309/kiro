# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 git에 올라가지 않는다.
# 키 값을 코드, 커밋, 채팅, 화면 공유에 노출하지 말 것.

# 충남대학교 aiportal BAZE > API Gateway에서 발급한 키
BAZE_API_KEY=

# BAZE Gateway Base URL (OpenAI 호환)
LLM_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway

# GET {LLM_BASE_URL}/models/ 결과에서 고른 모델 ID
LLM_MODEL=

# 모델 호출 시간 제한(초)
LLM_TIMEOUT_SEC=20

# 로컬 데이터 폴더 (기본: 프로젝트의 data/)
# APP_DATA_DIR=
